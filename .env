# Environment selection
# Set to 'development' for local development, 'production' for production deployment
NODE_ENV=development

# Database connection - REQUIRED FOR DEPLOYMENT
# In development, this will use the local PostgreSQL database
# In production deployment, make sure to set this secret
DATABASE_URL=postgres://neondb_owner:npg_FKDaTlJ5d9ew@localhost:5432/neondb

# Stripe API Keys - RECOMMENDED FOR DEPLOYMENT
# These keys are used for both development and production
STRIPE_SECRET_KEY=sk_test_placeholder
VITE_STRIPE_PUBLIC_KEY=pk_test_placeholder

# Session Configuration - REQUIRED FOR DEPLOYMENT
# This is used to encrypt session cookies and CSRF tokens
SESSION_SECRET=vibe_conference_session_secret

# Server configuration
PORT=5000
# Set to true in production for additional security
ENABLE_HTTPS=false